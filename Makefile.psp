# PSP build target for the OoT decomp fork.
#
# Deliberately kept as a separate Makefile (invoked via `make -f Makefile.psp`)
# rather than an ifeq-branch inside the main `Makefile`: that Makefile is a
# 1200+ line IDO/GCC dual-path, spec-driven build system for the byte-perfect
# N64 ROM target, and entangling a from-scratch PSP target into it risks
# breaking the verified-working N64 build. This file reuses the *pattern*
# (fork the decomp, add a PSP target) without touching the original.
#
# Unlike the N64 build, the file list here is NOT derived from the ROM `spec`
# — it's an explicit, incrementally-grown list (PSP_C_FILES below), same
# spirit as attempt 1's psp-port/Makefile. It starts with just the PSP-side
# engine skeleton (psp/src/) and grows to include ported decomp files
# (src/boot/z_std_dma.c, src/code/graph.c, etc.) as each gets wired in.

TARGET = ootpsp

# PSP-side engine skeleton (new code, not from the decomp): main loop, libultra
# shim, gfx_pc-style F3DEX2 interpreter/sceGu backend. See psp/README.md.
PSP_C_FILES := psp/src/main.c

# libultra/libu64 shim, carried forward from attempt 1 (zelda-oot-psp/psp-port).
# os_thread.c/os_mesg.c use real PSP threads/semaphores -- kept deliberately
# (see plan decision #4: DmaMgr, added next, needs a real consumer thread).
PSP_C_FILES += psp/src/libultra/os_thread.c
PSP_C_FILES += psp/src/libultra/os_mesg.c
PSP_C_FILES += psp/src/libultra/os_time.c
PSP_C_FILES += psp/src/libultra/os_cache.c
PSP_C_FILES += psp/src/libultra/os_cont.c
PSP_C_FILES += psp/src/libultra/os_rom.c
PSP_C_FILES += psp/src/libultra/os_syncprintf.c
PSP_C_FILES += psp/src/libultra/sleep.c

# Real decomp files, unmodified except bzero->memset and .errno->.errno_
# (see attempt 1's PORTING.md) -- hardware-format-only pad code, no threading.
PSP_C_FILES += psp/src/libu64/pad.c
PSP_C_FILES += psp/src/libu64/padsetup.c
PSP_C_FILES += psp/src/libu64/stackcheck.c

# Stand-ins needed to link DmaMgr without a full game link (see plan decision
# #4 / step 4): dummy segment symbols, dead N64DD globals, PI-bus entry
# points DmaMgr's audio/64DD paths call but that aren't wired up on PSP yet.
PSP_C_FILES += psp/src/libultra/segment_symbols_stub.c
PSP_C_FILES += psp/src/libultra/n64dd_stub.c
PSP_C_FILES += psp/src/libultra/os_pi.c
PSP_C_FILES += psp/src/libultra/fault.c
PSP_C_FILES += psp/src/libultra/os_interrupt_stub.c

# DmaMgr itself: real decomp code (src/boot/z_std_dma.c, src/boot/yaz0.c),
# unmodified except DmaMgr_DmaRomToRam's leaf hardware-transfer call, which
# now does a direct sceIo read against the .z64 shipped alongside EBOOT.PBP
# instead of N64 cartridge PI-bus DMA (see psp_rom.h / psp/src/boot/z_std_dma.c
# header comment). Kept on a real PSP thread deliberately -- see plan
# decision #4.
PSP_C_FILES += psp/src/boot/z_std_dma.c
PSP_C_FILES += psp/src/boot/yaz0.c

# 4-entry hand-built gDmaDataTable (real offsets from reference/oot's own
# pal-1.0 build map), standing in for the ~940-entry table a full game link
# would generate. Smoke-test only, replaced once real segments link.
PSP_C_FILES += psp/src/dmadata_test_table.c

# Real decomp engine files, collapsed to single-loop per plan decision #4.
# Edits are guarded with #if TARGET_PSP so the N64 pal-1.0 build (still built
# from this same fork's default Makefile) stays byte-identical.
# gfx_pc.c/gfx_cc.c ported from sm64-port-psp (see plan step 6) -- generic
# F3D/F3DEX2 display-list interpreter, confirmed N64-microcode-generic not
# SM64-specific. gfx_scegu.c is sm64-port-psp's PSP/sceGu backend, started
# with an EMPTIED shader-ID table (plan step 7) -- OoT's material set will
# need its own table built up empirically, not SM64's.
PSP_C_FILES += psp/src/gfx/gfx_pc.c
PSP_C_FILES += psp/src/gfx/gfx_cc.c
PSP_C_FILES += psp/src/gfx/gfx_scegu.c
PSP_C_FILES += psp/src/gfx/gfx_wm_psp.c
PSP_C_FILES += psp/src/gfx/psp_texture_manager.c

PSP_C_FILES += src/code/irqmgr.c
PSP_C_FILES += src/code/graph.c
PSP_C_FILES += src/code/main.c
PSP_C_FILES += src/code/padmgr.c
PSP_C_FILES += src/code/game.c
PSP_C_FILES += src/code/sys_cfb.c
PSP_C_FILES += src/code/TwoHeadGfxArena.c
PSP_C_FILES += src/libc64/malloc.c
PSP_C_FILES += src/boot/viconfig.c
PSP_C_FILES += src/code/title_setup.c
PSP_C_FILES += src/overlays/gamestates/ovl_title/z_title.c
PSP_C_FILES += src/overlays/gamestates/ovl_opening/z_opening.c
PSP_C_FILES += src/code/z_sram.c
PSP_C_FILES += src/code/z_inventory.c
PSP_C_FILES += src/code/z_play.c
PSP_C_FILES += psp/src/z_actor_dlftbls_psp.c
PSP_C_FILES += psp/src/z_endian_fixup_psp.c

# --- Compiled-in ("static") scene assets ---
# The decomp's own asset C source for the standing test scene, linked into the
# binary instead of being streamed out of the .z64. The compiler produces
# native-endian data and the linker resolves every internal reference to a real
# pointer, so neither the PspFixup*Endian passes nor segmented-address
# resolution apply to this scene at all. This is the "Option A vs Option B"
# fork from reference/libultraship/docs/PORTING.md -- see the long rationale in
# psp/include/psp_static_assets.h. Development mode only: PSP RAM cannot hold
# every scene, so this list stays deliberately short.
PSP_C_FILES += psp/src/psp_static_assets.c
# --- Phase 2: real gameplay-engine core (scene/room/camera/collision/actor) ---
PSP_C_FILES += src/code/z_scene.c
PSP_C_FILES += src/code/z_scene_table.c
PSP_C_FILES += src/code/z_room.c
PSP_C_FILES += src/code/z_construct.c
PSP_C_FILES += src/code/z_lights.c
PSP_C_FILES += src/code/z_vr_box.c
PSP_C_FILES += src/code/z_vr_box_draw.c
PSP_C_FILES += src/code/z_bgcheck.c
PSP_C_FILES += src/code/z_collision_check.c
PSP_C_FILES += src/code/z_camera.c
PSP_C_FILES += src/code/z_actor.c
PSP_C_FILES += src/code/z_skelanime.c
PSP_C_FILES += src/code/z_effect.c
PSP_C_FILES += src/code/z_effect_soft_sprite.c
PSP_C_FILES += src/code/sys_math3d.c
PSP_C_FILES += src/code/z_env_flags.c
PSP_C_FILES += src/code/z_nulltask.c
PSP_C_FILES += src/code/object_table.c
PSP_C_FILES += src/code/sys_math.c
PSP_C_FILES += src/code/z_olib.c

# Promoted out of phase2_stubs_gen.c. Not cosmetic: Camera_Update feeds
# Quake_Update's ShakeInfo out-parameter straight into the view's `at`, so a
# no-op stub left the camera adding uninitialised stack to its look-at target
# every frame -- the port's long-standing "perspective flips back and forth".
# See the note where the stubs used to be. Needs only Math_SinS / OLib_* /
# Rand_ZeroOne, all already linked above.
PSP_C_FILES += src/code/z_quake.c

# Promoted out of phase2_stubs_gen.c for the same reason: Environment_Update is
# a void function that writes through its EnvironmentContext*/LightContext*
# arguments, so the no-op stub meant the scene's ENV_LIGHT_SETTINGS never became
# real light state and every intensity-only texture (which takes ALL of its
# colour from the combiner) rendered white-grey. See the note where the stubs
# used to be.
#
# The asset files below are here because they are what z_kankyo.c's draw
# functions reference by symbol -- the sun/moon, lens flare, raindrop, lightning
# and shockwave models, plus gameplay_field_keep for gFieldSandstormDL. They are
# small (~95 KB of .o in total). Linking them is deliberate rather than
# --defsym'ing the symbols to dummies: fake asset data is the same category of
# problem the blob pipeline exists to remove.
PSP_C_FILES += src/code/z_kankyo.c
PSP_C_FILES += assets/objects/gameplay_keep/gameplay_keep_0x4D160.c
PSP_C_FILES += assets/objects/gameplay_keep/sun_textures.c
PSP_C_FILES += assets/objects/gameplay_keep/sun_evening_textures.c
PSP_C_FILES += assets/objects/gameplay_keep/moon.c
PSP_C_FILES += assets/objects/gameplay_keep/lens_flare.c
PSP_C_FILES += assets/objects/gameplay_keep/raindrop_model.c
PSP_C_FILES += assets/objects/gameplay_keep/eff_lightning.c
PSP_C_FILES += assets/objects/gameplay_keep/eff_shockwave.c

PSP_C_FILES += psp/src/phase2_stubs.c
# Real table, not a stub: it is walked as EffectSsOverlay[EFFECT_SS_TYPE_MAX]
# by z_effect_soft_sprite.c, and the 64-byte char stub it replaces made
# EffectSs_ClearAll free a wild pointer on every scene transition -- fatal on
# hardware. See the TARGET_PSP note in the file itself.
PSP_C_FILES += src/code/z_effect_soft_sprite_dlftbls.c
PSP_C_FILES += psp/src/phase2_stubs_gen.c
PSP_C_FILES += psp/src/segment_roms_psp.c
PSP_C_FILES += psp/src/phase2_debug_log.c
# --- Phase 3: world actors -------------------------------------------------
# Every actor is a weak alias to a no-op dummy in z_actor_dlftbls_psp.c until
# its .c is listed here, at which point the strong symbol wins. Adding one is
# therefore just this line plus whatever objects/assets it references.
PSP_C_FILES += src/overlays/actors/ovl_En_Kusa/z_en_kusa.c
PSP_C_FILES += src/overlays/actors/ovl_Obj_Kibako2/z_obj_kibako2.c
PSP_C_FILES += src/overlays/actors/ovl_En_Wood02/z_en_wood02.c
PSP_C_FILES += src/overlays/actors/ovl_En_Dog/z_en_dog.c
PSP_C_FILES += src/overlays/actors/ovl_En_Door/z_en_door.c
# En_Door's models: the generic wooden door lives in gameplay_keep, the three
# dungeon variants in their own scene objects (En_Door indexes them all through
# one table, so all four have to be present even in a scene that uses one).
PSP_C_FILES += assets/objects/gameplay_keep/door_skel.c
PSP_C_FILES += assets/objects/gameplay_keep/gDoorAdultOpeningLeftAnim.c
PSP_C_FILES += assets/objects/gameplay_keep/gDoorAdultOpeningRightAnim.c
PSP_C_FILES += assets/objects/gameplay_keep/gDoorChildOpeningLeftAnim.c
PSP_C_FILES += assets/objects/gameplay_keep/gDoorChildOpeningRightAnim.c
# Engine sources these actors pull in (DynaPolyActor_Init / the path system).
PSP_C_FILES += src/code/z_bg_item.c
PSP_C_FILES += src/code/z_path.c
# The "old init" soft-sprite spawners (func_8002829C, EffectSsDeadDb_Spawn,
# EffectSsHahen_SpawnBurst). Pulled in by the Bg_* scenery actors below;
# compiled for real rather than stubbed because the effect system it drives
# (z_effect_soft_sprite.c and its real dlftbls table) is already in the build.
PSP_C_FILES += src/code/z_effect_soft_sprite_old_init.c
PSP_C_FILES += assets/objects/gameplay_keep/cuttable_shrub.c
# En_Holl: the invisible plane that triggers Room_RequestNewRoom when Link
# walks through it. Measured (offline inventory of every ActorEntryList under
# extracted/pal-1.0/assets/scenes): 203 instances across the game, and it is
# the ONLY transition actor in Kokiri Forest (29x), Temple of Time (12x) and
# Royal Family Tomb -- three of the scenes reported as "the player cannot get
# into the next room". As a dummy it spawns and does nothing, so the room load
# is never requested. Draws from gameplay_keep plus its own inline plane DL,
# so it costs one object file and no new dependency web.
PSP_C_FILES += src/overlays/actors/ovl_En_Holl/z_en_holl.c
# Door_Shutter: the dungeon door, and the transition actor for Treasure Box
# Shop (6x), Spirit Temple Boss (12x), Gerudo Training (21x), Ganon's Tower
# (19x) and Lord Jabu-Jabu (32x) -- the rest of the "cannot reach the next
# room" reports. 269 instances game-wide. It indexes ONE table covering every
# dungeon's door model, so all of its objects have to be resident even in a
# scene that uses a single variant, exactly like En_Door.
PSP_C_FILES += src/overlays/actors/ovl_Door_Shutter/z_door_shutter.c
# Door_Shutter's model table: every dungeon's door variant plus the boss doors
# in gameplay_keep. All of them, because the actor selects by scene at runtime.
PSP_C_FILES += assets/objects/gameplay_keep/gameplay_keep_0x49F20.c
PSP_C_FILES += assets/objects/gameplay_keep/gameplay_keep_0x4A090.c
# The chain and lock textures the barred-door variants draw over the model.

# --- Scenery actors named by the offline actor inventory --------------------
# Every ActorEntryList under extracted/pal-1.0/assets/scenes was counted and
# matched against the reported "part of the room is missing" scenes. Each line
# below is one of those matches, with the count that named it. None of this is
# a renderer defect: the geometry is drawn by an actor that was a no-op dummy.
#
# Deku Tree, lower floor: the floor there IS the giant spider web, drawn and
# collided by Bg_Ydan_Sp (7x in ydan). Hasi (the bridge, 4x) and Maruta (the
# rotating logs, 2x) share its object and are the same room's missing pieces.
PSP_C_FILES += src/overlays/actors/ovl_Bg_Ydan_Sp/z_bg_ydan_sp.c
PSP_C_FILES += src/overlays/actors/ovl_Bg_Ydan_Hasi/z_bg_ydan_hasi.c
PSP_C_FILES += src/overlays/actors/ovl_Bg_Ydan_Maruta/z_bg_ydan_maruta.c
# Kokiri Forest: "the Deku Tree is incomplete". Bg_Treemouth (12x in spot04) is
# the tree's mouth -- the entrance geometry, not part of the room model.
PSP_C_FILES += src/overlays/actors/ovl_Bg_Treemouth/z_bg_treemouth.c
# Kakariko Village: "a whole house is missing, only the door is there".
# Bg_Spot01_Objects2 (14x in spot01) draws the houses themselves.
PSP_C_FILES += src/overlays/actors/ovl_Bg_Spot01_Objects2/z_bg_spot01_objects2.c
# Ice Cavern: "floor areas completely black, see-through into other rooms".
# Bg_Ice_Shelter (23x) is the ice platform/block geometry; its object is
# already resident for Door_Shutter's ice variant.
PSP_C_FILES += src/overlays/actors/ovl_Bg_Ice_Shelter/z_bg_ice_shelter.c
# Bottom of the Well: "holes, see-through into the map". Bg_Haka_Megane is the
# false wall/floor set (3x in HAKAdanCH).
PSP_C_FILES += src/overlays/actors/ovl_Bg_Haka_Megane/z_bg_haka_megane.c
# Temple of Time: the Master Sword room. Bg_Toki_Swd is the pedestal and sword
# (11x), Bg_Toki_Hikari the light shafts (16x).
PSP_C_FILES += src/overlays/actors/ovl_Bg_Toki_Swd/z_bg_toki_swd.c
PSP_C_FILES += src/overlays/actors/ovl_Bg_Toki_Hikari/z_bg_toki_hikari.c
# Shadow Temple boss room: "the floor at the bottom of the pit is missing, the
# player falls through -- collision, not just optics". Measured: HAKAdan_bs
# room 1 contains exactly ONE actor, ACTOR_BOSS_SST. Bongo Bongo's drum IS the
# floor of that room -- there is no room-model floor to draw -- so as a dummy
# there is nothing to stand on. This is the report's own description of the
# mechanism, arrived at from the scene data rather than from the renderer.
PSP_C_FILES += src/overlays/actors/ovl_Boss_Sst/z_boss_sst.c
PSP_C_FILES += assets/objects/gameplay_keep/gameplay_keep_0x173D0.c
# Bg_Sst_Floor: Bongo Bongo's drum as a walkable surface. Boss_Sst DRAWS the
# drum but spawns this actor at runtime (z_boss_sst.c:303) for the collision --
# DynaPolyActor_Init + DynaPoly_SetBgActor(gBongoDrumCol). Without it the player
# sees the drum and falls straight through it, which is exactly what the user
# reported once Boss_Sst was in. Costs no new object file: object_sst is already
# resident for Boss_Sst.
#
# Note for the next actor hunt: psp/tools/actor_inventory.py reads SCENE data and
# therefore cannot see this actor at all -- nothing places it, another actor
# spawns it. The inventory is a LOWER BOUND. When a newly enabled actor draws but
# misbehaves, grep its own source for Actor_Spawn before trusting the inventory.
PSP_C_FILES += src/overlays/actors/ovl_Bg_Sst_Floor/z_bg_sst_floor.c

# --- The water surfaces -----------------------------------------------------
# Four "the water is missing" reports, four actors that draw it. In OoT a water
# surface is an ACTOR, not room geometry, so as dummies these scenes are simply
# dry. Two of them cost nothing but this line: their objects are already resident
# because other actors brought them in.
#
#   Bg_Mizu_Water      Water Temple        11x  object_mizu_objects   (En_Door)
#   Bg_Haka_Water      Bottom of the Well   1x  object_hakach_objects (Bg_Haka_Megane)
#   Bg_Spot07_Taki     Zora's Domain        6x  object_spot07_object  (new)
#   Bg_Spot06_Objects  Lake Hylia          13x  object_spot06_objects (new)
PSP_C_FILES += src/overlays/actors/ovl_Bg_Mizu_Water/z_bg_mizu_water.c
PSP_C_FILES += src/overlays/actors/ovl_Bg_Haka_Water/z_bg_haka_water.c
PSP_C_FILES += src/overlays/actors/ovl_Bg_Spot07_Taki/z_bg_spot07_taki.c
PSP_C_FILES += src/overlays/actors/ovl_Bg_Spot06_Objects/z_bg_spot06_objects.c

# --- Object DATA: none of it is linked in any more --------------------------
# Thirty object .c files used to be listed here, one per actor that had been
# enabled by hand. They are gone, and this is the note that explains the empty
# space rather than leaving it a mystery.
#
# Every one of them is now a blob (psp/tools/make_object_blobs.py), and their
# asset symbols come from psp/build/psp_object_syms_gen.c as weak segment
# addresses. While the .c files were also still listed here, each object existed
# TWICE: once as data in the EBOOT, once as a blob on the stick -- and because a
# strong definition beats a weak one, the EBOOT copy always won and the blob was
# dead weight. 1217 KB of it.
#
# They were deliberately left in place for one build, so that the actors that
# already worked kept their exact previous data path while the blob path was
# under test. That test is over: the great majority of the game's 381 objects
# only ever existed as blobs, and they draw -- the Kokiri boy, the market
# townspeople, the plants. Keeping the duplicates would now be the less
# justified choice, not the safer one.
#
# WHAT DELIBERATELY STAYS LINKED IN, and why:
#   assets/objects/gameplay_keep/*.c   Its player_anim_headers hold REAL
#       pointers into the compiled-in link_animetion (see the TARGET_PSP note in
#       AnimTaskQueue_AddLoadPlayerFrame). Those cannot become segment
#       addresses, so gameplay_keep must keep its EBOOT copy. Its blob still
#       exists and serves segment 4 for everything else.
#   link_animetion.c                   Same reason, from the other end.
#   object_link_child/boy              Correct to blob -- z_actor.c:939 points
#       segment 6 at every actor's own object, Player included -- but Player is
#       the one path that has worked reliably throughout, so it is changed
#       separately rather than bundled in here. 402 KB still to gain.

# --- Scene textures named directly by z_scene_table.c -----------------------
# Generated: psp/tools/gen_scene_textures.py copies the definitions out of the
# scene sources, because those symbols are referenced by C name while the scenes
# themselves are runtime blobs. They were 64-byte placeholders, and a placeholder
# is worse than nothing here -- the display list reads a full texture from the
# address regardless, so the GE got the neighbouring globals as pixels. That is
# the Dodongo's Cavern lava and the coloured pixel bands on the Kakariko and
# Lon Lon walls. ~78 KB of real data.
PSP_C_FILES += psp/build/psp_scene_textures_gen.c
# The 41st of that set. It is not scene data at all -- it lives in gameplay_keep
# and simply had never been compiled in.
PSP_C_FILES += assets/objects/gameplay_keep/lens_mask_tex.c

# --- Phase 3: EVERY actor ---------------------------------------------------
# The blocks above enabled actors one at a time, each with its object files
# linked into the EBOOT alongside it. That approach ran out of room, not of
# patience: the game's 381 objects are 9.8 MB of data and a PSP-1000 has ~24 MB
# of user RAM to hold the module, the 1000 KB object bank, the ~1.8 MB Zelda
# arena and the audio heap.
#
# psp/tools/make_object_blobs.py removes the constraint. Every object is linked
# at its N64 segment base and shipped as a blob, exactly like scenes and rooms
# already are, and the asset symbols an actor references are emitted as WEAK
# absolute segment addresses (psp/build/psp_object_syms_gen.c). The engine's own
# Object_UpdateEntries then loads one object at a time into the object bank and
# points segment 6 at it -- which is what the console does.
#
# So the whole set goes in. Measured before it was: all 426 actor sources
# compile unmodified, adding ~2.6 MB of text and ~0.4 MB of data, and the only
# symbols they reference that neither the blobs nor the EBOOT already define
# are the 35 engine functions and the scene-owned cutscene scripts handled
# below.
#
# Wildcard, not a hand-written list: a list of 426 lines is a list that goes
# stale. The *_colchk.inc.c / *_cutscene_data.inc.c files are #included by their
# actor rather than compiled on their own, so they are filtered out -- they do
# not compile standalone (no ARRAY_COUNT, no PLAYER_CUEID_*).
PSP_ALL_ACTOR_SRCS := $(filter-out %.inc.c,$(wildcard src/overlays/actors/ovl_*/z_*.c))
PSP_C_FILES += $(PSP_ALL_ACTOR_SRCS)

# Engine files the newly enabled actors call into. Each was measured as a
# genuinely undefined symbol across the whole actor set, not guessed at:
#   z_fcurve_data_skelanime.c  SkelCurve_*      (curve-animated actors)
#   z_skin.c / z_skin_awb.c    Skin_*           (skin-deformed enemies)
#   z_horse.c                  Horse_*
#   z_eff_blure.c              EffectBlure_AddSpace
#   z_eff_ss_dead.c            func_80026230 / func_80026690
#   z_face_reaction.c          MaskReaction_GetTextId
#   z_elf_message.c            QuestHint_*
#   z_en_item00.c              Item_DropCollectible2 (and En_Item00 itself,
#                              an internal actor the table already points at)
PSP_C_FILES += src/code/z_fcurve_data_skelanime.c
PSP_C_FILES += src/code/z_fcurve_data.c
PSP_C_FILES += src/code/z_skin.c
PSP_C_FILES += src/code/z_skin_awb.c
PSP_C_FILES += src/code/z_horse.c
PSP_C_FILES += src/code/z_eff_blure.c
PSP_C_FILES += src/code/z_eff_ss_dead.c
PSP_C_FILES += src/code/z_face_reaction.c
PSP_C_FILES += src/code/z_elf_message.c
PSP_C_FILES += src/code/z_en_item00.c
# En_A_Obj, the third DEFINE_ACTOR_INTERNAL actor (the wooden signs, cubes and
# tree stumps built from gameplay_keep models). It lives in src/code/ rather
# than src/overlays/actors/, so the wildcard above cannot see it -- with 428 of
# 429 profiles strongly defined, this was the one still falling through to
# gDummyActorProfile.
PSP_C_FILES += src/code/z_en_a_keep.c
# The remainder: functions belonging to subsystems that are still stubbed
# wholesale (Interface, Message, OnePointCutscene, Cutscene) plus two libultra
# odds and ends. Kept in one file so the boundary between "ported" and
# "not yet" stays visible in one place rather than spread through the build.
PSP_C_FILES += psp/src/phase3_actor_stubs.c
# Weak absolute addresses for every object asset symbol, and for the cutscene
# scripts that live in scene files. Both are generated; see their rules below.
PSP_C_FILES += psp/build/psp_object_syms_gen.c
PSP_C_FILES += psp/build/psp_scene_syms_gen.c

# --- Phase 2: real Player (flattened, no overlay indirection -- see file header) ---
PSP_C_FILES += src/overlays/actors/ovl_player_actor/z_player.c
PSP_C_FILES += psp/src/z_player_profile_psp.c
PSP_C_FILES += assets/objects/gameplay_keep/player_anim_headers.c
PSP_C_FILES += src/code/z_player_lib.c
PSP_C_FILES += assets/objects/object_link_child/object_link_child.c
PSP_C_FILES += assets/objects/gameplay_keep/hover_boots_circle.c
PSP_C_FILES += assets/objects/gameplay_keep/gameplay_keep_0x33910.c
PSP_C_FILES += extracted/pal-1.0/assets/misc/link_animetion/link_animetion.c
PSP_C_FILES += assets/objects/gameplay_keep/link_textures.c
PSP_C_FILES += assets/objects/gameplay_keep/gameplay_keep_0x32090.c
PSP_C_FILES += assets/objects/object_link_boy/object_link_boy.c
PSP_C_FILES += assets/objects/gameplay_keep/hilite_textures.c
PSP_C_FILES += assets/objects/gameplay_keep/player_pause_joint_tables.c
PSP_C_FILES += psp/src/phase2_player_stubs.c
PSP_C_FILES += src/code/z_DLF.c
PSP_C_FILES += psp/src/gamestate_table_psp.c
PSP_C_FILES += psp/src/phase1_stubs.c

PSP_C_FILES += src/code/sys_matrix.c
PSP_C_FILES += src/code/z_view.c
PSP_C_FILES += src/code/z_rcp.c
PSP_C_FILES += src/code/z_debug.c
# z_sram.c NOT linked for TARGET_PSP: Sram_InitSram/Sram_Alloc are the only
# functions z_title.c's ConsoleLogo state actually calls, but the full file
# (save-file corruption repair) drags in Inventory/Rumble/Audio/ZeldaArena
# as a side effect -- stubbed instead, see psp/src/phase1_stubs.c.
PSP_C_FILES += src/code/z_common_data.c
PSP_C_FILES += src/code/TwoHeadArena.c
# z_vismono.c/z_viszbuf.c NOT linked for TARGET_PSP: both hardcode real N64
# KSEG1 physical addresses (D_0E000000/D_0F000000, real linker-script-
# provided symbols for RDRAM scratch regions used by these debug
# framebuffer visualizers) that don't exist on PSP -- stubbed instead
# (debug-hotkey-only tools, never exercised by Phase 1's boot path anyway).
PSP_C_FILES += src/code/z_viscvg.c
PSP_C_FILES += src/code/gamealloc.c
PSP_C_FILES += src/code/z_rumble.c
PSP_C_FILES += src/code/speed_meter.c
PSP_C_FILES += src/code/z_vimode.c
PSP_C_FILES += src/code/gfxalloc.c
PSP_C_FILES += src/code/sys_freeze.c
PSP_C_FILES += src/libc64/__osMalloc_n64.c
PSP_C_FILES += src/libu64/debug.c
PSP_C_FILES += psp/src/libultra/os_vi_misc_stub.c

PSP_C_FILES += src/code/sched.c
PSP_C_FILES += src/libc64/math64.c
PSP_C_FILES += src/code/z_memory_utils.c
PSP_C_FILES += src/libu64/gfxprint.c
PSP_C_FILES += src/libu64/runtime.c
PSP_C_FILES += src/code/z_prenmi_buff.c
PSP_C_FILES += src/libultra/gu/ortho.c
PSP_C_FILES += src/libultra/gu/lookat.c
PSP_C_FILES += src/libultra/gu/lookathil.c
PSP_C_FILES += src/libultra/gu/perspective.c
PSP_C_FILES += src/libultra/gu/translate.c
PSP_C_FILES += src/libultra/gu/mtxutil.c
PSP_C_FILES += src/code/z_lib.c
PSP_C_FILES += src/libc64/aprintf.c
PSP_C_FILES += psp/src/libultra/trig_stub.c
PSP_C_FILES += src/code/sys_rumble.c
PSP_C_FILES += src/code/z_skin_matrix.c
PSP_C_FILES += src/code/z_malloc.c
PSP_C_FILES += src/libc64/qrand.c
PSP_C_FILES += src/code/shrink_window.c
PSP_C_FILES += src/code/sys_math_atan.c
PSP_C_FILES += src/libultra/libc/xprintf.c
PSP_C_FILES += src/libultra/libc/xldtob.c
PSP_C_FILES += src/libultra/libc/xlitob.c
PSP_C_FILES += src/buffers/gfxbuffers.c
PSP_C_FILES += src/buffers/zbuffer.c
PSP_C_FILES += src/buffers/audio_heap.c
PSP_C_FILES += extracted/pal-1.0/assets/textures/nintendo_rogo_static/nintendo_rogo_static.c
PSP_C_FILES += extracted/pal-1.0/assets/textures/icon_item_static/icon_item_static.c
PSP_C_FILES += assets/textures/icon_item_24_static/icon_item_24_static.c
PSP_C_FILES += extracted/pal-1.0/assets/textures/parameter_static/parameter_static.c

PSP_C_FILES += psp/src/psp_blob_assets.c
PSP_C_FILES += psp/src/psp_hw_diag.c
PSP_C_FILES += psp/src/psp_frame_pace.c

# Development aid: L + D-Pad steps through the pre-rendered-background test
# scenes without a rebuild. See the file header.
PSP_C_FILES += psp/src/psp_test_scenes.c

# Development aid: SELECT opens a warp menu listing every scene. See the file
# header. Its scene list is generated from the decomp's own tables, so it never
# needs updating by hand.
PSP_C_FILES += psp/src/psp_scene_menu.c
PSP_C_FILES += psp/src/psp_screenshot.c

# --- Audio (Phase 1 bring-up) -------------------------------------------------
#
# The real N64 audio engine (src/audio/**) is platform-agnostic C for the
# sequence/note/envelope layers, but NOT for synthesis: AudioSynth_Update
# (src/audio/internal/synthesis.c) only builds a command list for the RSP's
# aspMain microcode, which is what actually decodes ADPCM, resamples and
# mixes into gAudioCtx.aiBuffers[]. So, exactly like graphics, there IS an
# RSP ucode to reimplement -- psp/src/audio/psp_audio_mixer.c does it in
# software. On top of that, two real N64 AI (Audio Interface) hardware
# touchpoints (osAiSetNextBuffer/osAiGetLength) need PSP replacements -- see
# psp/src/audio/audio_psp.c and src/audio/internal/os.c's TARGET_PSP branch.
# Full background: psp/docs/AUDIO_N64_VS_PSP.md.
# debug.inc.c is #included by general.c, not a standalone translation unit.
PSP_C_FILES += src/audio/game/data.c
PSP_C_FILES += src/audio/game/general.c
PSP_C_FILES += src/audio/game/sequence.c
PSP_C_FILES += src/audio/game/session_config.c
PSP_C_FILES += src/audio/game/session_init.c
PSP_C_FILES += src/audio/game/sfx.c
PSP_C_FILES += src/audio/game/sfx_params.c
PSP_C_FILES += src/audio/internal/data.c
PSP_C_FILES += src/audio/internal/effects.c
PSP_C_FILES += src/audio/internal/heap.c
PSP_C_FILES += src/audio/internal/load.c
PSP_C_FILES += src/audio/internal/os.c
PSP_C_FILES += src/audio/internal/playback.c
PSP_C_FILES += src/audio/internal/seqplayer.c
PSP_C_FILES += src/audio/internal/synthesis.c
PSP_C_FILES += src/audio/internal/thread.c
PSP_C_FILES += src/code/audio_thread_manager.c
PSP_C_FILES += src/code/audio_stop_all_sfx.c
PSP_C_FILES += psp/src/audio/audio_psp.c
PSP_C_FILES += psp/src/audio/psp_audio_mixer.c
# The microcode interpreter and the Media Engine offload that uses it. See
# psp/include/psp_audio_me.h -- the mixer now runs on the PSP's second core,
# with the audio thread as the fallback whenever the ME is unavailable (which
# includes every run under PPSSPP).
PSP_C_FILES += psp/src/audio/psp_audio_cmdlist.c
PSP_C_FILES += psp/src/audio/psp_audio_me.c
PSP_C_FILES += psp/src/audio/psp_audio_stage.c
PSP_C_FILES += psp/src/audio/psp_audio_debug.c
# Overrun probe -- see psp/include/psp_audio_probe.h.
PSP_C_FILES += psp/src/audio/psp_audio_probe.c

# src/audio/tables/{sequence,soundfont,samplebank}_table.c are deliberately NOT
# built here. They are the real decomp files and they enumerate the right
# assets, but every romAddr in them is a `(u32)Name_Start` linker symbol whose
# value only exists because the N64 build LINKS each asset into the ROM's
# Audiobank/Audioseq/Audiotable segments. This port serves them as separate
# blob files, so it needs the same tables with its own addresses -- generated
# from the very same headers by psp/tools/gen_audio_tables.py, so no entry is
# ever transcribed by hand. Literal path, not $(PSP_AUDIO_TABLES_C): PSP_C_FILES
# is a := variable, so += expands immediately and a variable defined further
# down the file would append nothing at all.
PSP_C_FILES += psp/build/psp_audio_tables_gen.c

# $(sort) as much for its side effect as for the order: it removes duplicates.
# The actor block below adds every actor by wildcard while the hand-written
# lines that named a dozen of them individually are kept for their comments,
# so the same .c genuinely appears twice -- and a repeated entry here would
# compile fine and then fail the link with a few hundred duplicate symbols.
OBJS := $(sort $(PSP_C_FILES:.c=.o))
# Assembled, not compiled, so it cannot ride along in PSP_C_FILES. This is the
# real generated sequence->soundfont mapping table (see its rule below).
OBJS += psp/build/assets/audio/sequence_font_table.o

# --- Build stamp -------------------------------------------------------------
#
# gPspBuildId names the build that is actually running. It is read off the HUD
# and over the debugger, and three separate measurements this project made
# against a build the emulator had never loaded were only caught because of it.
#
# It CANNOT be __DATE__/__TIME__ inside an ordinary source file: those expand
# when that one file is compiled, so a build that only touched the renderer left
# the stamp reading whenever psp_scene_menu.c last happened to be rebuilt --
# which is worse than no stamp, because it looks authoritative while being
# stale. FORCE makes this one file regenerate on every invocation, so the stamp
# always names the link.
PSP_BUILD_STAMP_C := psp/build/build_stamp.c
OBJS += $(PSP_BUILD_STAMP_C:.c=.o)

.PHONY: FORCE
FORCE:

$(PSP_BUILD_STAMP_C): FORCE
	@mkdir -p $(dir $@)
	@printf 'char gPspBuildId[24] = "%s";\n' "$$(date '+%b %d %H:%M:%S')" > $@.tmp
	@cmp -s $@.tmp $@ || mv $@.tmp $@
	@rm -f $@.tmp

# --- Native-endian asset blobs -----------------------------------------------
#
# See psp/include/psp_blob_assets.h. Each scene listed here is linked at its N64
# segment base and objcopy'd to a flat binary, so its data is native-endian with
# every internal pointer already a real segment address -- no PspFixup*Endian
# pass, no hand-listed struct offsets.
#
# Format: <asset-subdir>:<scene-name>:<room-count>
BLOB_DIR = build/blobs
# Derived from the extracted assets by psp/tools/list_scenes.sh rather than
# hand-listed: the scene set, each scene's room count and its asset subdirectory
# are all already unambiguous on disk, and a hand-maintained list silently
# produced an empty scene whenever something was forgotten. All 101 scenes.
BLOB_SCENES := $(shell sh psp/tools/list_scenes.sh extracted/pal-1.0)

BLOB_REGISTRY = $(BLOB_DIR)/blobs_registry.inc
# Audio blobs go in a SECOND registry because they are looked up differently:
# scene/room blobs are always read whole (exact vromStart match), while the
# sample bank is DMA'd a few hundred bytes at a time from arbitrary offsets
# inside it -- see the sRangedBlobs comment in psp/src/psp_blob_assets.c.
# Ranged lookup needs each blob's size, which is why this one carries it.
BLOB_RANGED_REGISTRY = $(BLOB_DIR)/blobs_ranged_registry.inc

# Audio asset lists, needed here (not just in the audio-assets block below)
# because GNU Make expands a rule's PREREQUISITE LIST immediately when it
# parses that rule -- unlike a recipe body, which is expanded lazily -- so
# $(BLOB_REGISTRY)'s rule just below needs AUDIO_BLOB_BINS already defined at
# this point. (Cost a real debugging round trip once: the rule silently
# expanded to nothing extra, and only `make -p`'s database dump showed it.)
#
# The names come from the game's own table headers, via the same script that
# generates the tables, so the set of assets built and the set the table
# describes cannot disagree -- there is no hand-maintained list of either.
AUDIO_SRC_DIR = build/pal-1.0/assets/audio
PSP_AUDIO_DIR = psp/build/assets/audio
AUDIO_TABLE_GEN = psp/tools/gen_audio_tables.py
AUDIO_TABLE_ARGS = --seq-table include/tables/sequence_table.h \
                   --font-table $(AUDIO_SRC_DIR)/soundfont_table.h \
                   --bank-table $(AUDIO_SRC_DIR)/samplebank_table.h \
                   --audio-build-dir $(AUDIO_SRC_DIR)
AUDIO_BLOB_NAMES := $(shell python3 $(AUDIO_TABLE_GEN) $(AUDIO_TABLE_ARGS) --list-blobs 2>/dev/null)
AUDIO_BLOB_BINS = $(patsubst %,$(BLOB_DIR)/%.bin,$(AUDIO_BLOB_NAMES))
AUDIO_FONT_OBJS = $(patsubst %,$(PSP_AUDIO_DIR)/%.o,$(filter Soundfont_%,$(AUDIO_BLOB_NAMES)))
AUDIO_SEQ_OBJS = $(patsubst %,$(PSP_AUDIO_DIR)/%.o,$(filter seq_%,$(AUDIO_BLOB_NAMES)))
AUDIO_BANK_OBJS = $(patsubst %,$(PSP_AUDIO_DIR)/%.o,$(filter SampleBank_%,$(AUDIO_BLOB_NAMES)))

# Generated by the same script; replaces the two-soundfont hand-built stand-in.
PSP_AUDIO_TABLES_C = psp/build/psp_audio_tables_gen.c

# PSPSDK's build.mak (included at the bottom of this file) is what defines `all`,
# so the blob rule below would otherwise become the default goal simply by being
# the first target in the file.
.DEFAULT_GOAL := all

# Regenerated whenever the tool, the JFIF decoder or the scene list changes --
# this file is a prerequisite precisely because BLOB_SCENES lives in it, and
# without it adding a scene to that list silently produces no blob (the registry
# is already up to date with respect to the script alone). The generated registry
# maps each file's vromStart to its blob path; psp_blob_assets.c #includes it, so
# no vrom hex is ever written by hand.
$(BLOB_REGISTRY): psp/tools/make_scene_blob.sh psp/tools/jfif_to_psp.py Makefile.psp $(AUDIO_BLOB_BINS) $(OBJECT_SYMS_C)
	@rm -f $(BLOB_DIR)/*.reg $(BLOB_DIR)/*.sym
	@for s in $(BLOB_SCENES); do \
		d=$${s%%:*}; r=$${s##*:}; n=$${s#*:}; n=$${n%:*}; \
		echo "  BLOB    $$n ($$r room(s))"; \
		sh psp/tools/make_scene_blob.sh \
			extracted/pal-1.0/assets/scenes/$$d $$n $(BLOB_DIR) $$r > /dev/null || exit 1; \
	done
	@cat $(BLOB_DIR)/*.reg $(OBJECT_REGISTRY) > $@

# --- Object blobs -----------------------------------------------------------
# Every object linked at its N64 segment base and shipped as a flat binary, so
# the 9.8 MB of object data does not have to fit in the EBOOT. See
# psp/tools/make_object_blobs.py for the full rationale; the short version is
# that the engine already loads objects one at a time into a 1000 KB bank, and
# this just gives that bank native-endian data to load.
#
# The two outputs must be produced together and are: the registry maps each
# object's vromStart to its blob, and the symbol file gives the addresses inside
# that blob. A stale pairing would resolve a symbol into the wrong object.
OBJECT_SYMS_C = psp/build/psp_object_syms_gen.c
# Deliberately NOT a .reg: the scene rule clears $(BLOB_DIR)/*.reg before it
# regenerates the per-scene fragments, and this one is written by a different
# rule that has already run by then.
OBJECT_REGISTRY = $(BLOB_DIR)/objects.reginc
OBJECT_BLOB_TOOL = psp/tools/make_object_blobs.py

$(OBJECT_SYMS_C): $(OBJECT_BLOB_TOOL) build/pal-1.0/spec psp/src/segment_roms_psp.c
	@mkdir -p $(BLOB_DIR) psp/build
	python3 $(OBJECT_BLOB_TOOL) $(BLOB_DIR) \
		--syms-out $(OBJECT_SYMS_C) --reg-out $(OBJECT_REGISTRY)

# Order-only-style pairing: the registry is written by the rule above, so
# asking for it separately must not re-run the tool.
$(OBJECT_REGISTRY): $(OBJECT_SYMS_C)
	@:

# --- Scene-owned symbols ----------------------------------------------------
# Cutscene scripts (gZeldasCourtyardMeetCs and ~40 others) live in scene files
# and are named directly by actors. make_scene_blob.sh writes one .sym per
# scene; this turns the collection into weak absolute segment-2 definitions.
#
# WEAK for the same reason the object symbols are: psp_scene_textures_gen.c
# already compiles some scene data into the EBOOT, and a strong definition
# there must keep winning.
SCENE_SYMS_C = psp/build/psp_scene_syms_gen.c
$(SCENE_SYMS_C): $(BLOB_REGISTRY)
	@mkdir -p psp/build
	@{ echo '/* GENERATED from the scene blob links -- do not edit. */'; \
	   cat $(BLOB_DIR)/*.sym | sort -u | while read sym addr scene; do \
	     printf '__asm__(".globl %s\\n.weak %s\\n%s = 0x%08x\\n");\n' \
	       "$$sym" "$$sym" "$$sym" \
	       $$(( (0x$$addr - 0x08804000) & 0xffffffff )); \
	   done; } > $@

# The ranged registry and the C table are emitted together, from one address
# assignment: they must agree exactly, and two hand-kept lists of 150-odd
# addresses would not stay in step. Sizes are read off the built .bin files, so
# a stale or half-built blob can never be described as bigger than it is
# (which would turn a ranged read into a silent short read of zeroes).
$(BLOB_RANGED_REGISTRY): $(AUDIO_BLOB_BINS) $(AUDIO_TABLE_GEN) include/tables/sequence_table.h
	@mkdir -p $(BLOB_DIR) psp/build
	python3 $(AUDIO_TABLE_GEN) $(AUDIO_TABLE_ARGS) \
		--blob-dir $(BLOB_DIR) --out-c $(PSP_AUDIO_TABLES_C) --out-reg $(BLOB_RANGED_REGISTRY)

$(PSP_AUDIO_TABLES_C): $(BLOB_RANGED_REGISTRY)
	@:

# Ship the blobs next to EBOOT.PBP: PSP resolves the registry's relative paths
# ("blobs/<name>.bin") against the EBOOT's own directory. Separate rule with its
# own stamp so the copy still happens when the registry is already up to date.
blobs/.stamp: $(BLOB_REGISTRY) $(BLOB_RANGED_REGISTRY) $(OBJECT_SYMS_C)
	@mkdir -p blobs && cp -f $(BLOB_DIR)/*.bin blobs/ && touch $@

psp/src/psp_blob_assets.o: $(BLOB_REGISTRY) $(BLOB_RANGED_REGISTRY)

# Warp-menu scene list, generated from include/tables/{scene,entrance}_table.h,
# filtered against BLOB_SCENES (see gen_scene_menu.py's header) so a scene with
# no real asset data -- e.g. SCENE_BESITU, an unused leftover with no baserom
# entry at all -- can't be selected and load garbage. BLOB_SCENES is a
# dependency here via the same list_scenes.sh $(shell) call as BLOB_REGISTRY,
# so this regenerates whenever the scene set does.
SCENE_MENU_INC = $(BLOB_DIR)/psp_scene_menu.inc
$(SCENE_MENU_INC): include/tables/scene_table.h include/tables/entrance_table.h psp/tools/gen_scene_menu.py
	@mkdir -p $(BLOB_DIR)
	@python3 psp/tools/gen_scene_menu.py include $@ $(BLOB_SCENES)

# The scene textures z_scene_table.c names by C symbol. Generated rather than
# hand-written: the definitions are copied verbatim out of the scene sources, so
# a change there cannot silently drift away from what is compiled in. Depends on
# z_scene_table.c because that is the file that names these symbols in the first
# place -- add a draw config that references a new texture and this picks it up.
# (It deliberately does NOT read the placeholder list: that was circular, and
# removing the placeholders once made the generator emit nothing.)
SCENE_TEX_GEN = psp/build/psp_scene_textures_gen.c
$(SCENE_TEX_GEN): psp/tools/gen_scene_textures.py src/code/z_scene_table.c
	@mkdir -p psp/build
	@python3 psp/tools/gen_scene_textures.py . $@

MENU_FONT_INC = $(BLOB_DIR)/psp_menu_font.inc
$(MENU_FONT_INC): psp/tools/gen_menu_font.py
	@mkdir -p $(BLOB_DIR)
	@python3 psp/tools/gen_menu_font.py $@

psp/src/psp_scene_menu.o: $(SCENE_MENU_INC) $(MENU_FONT_INC)
psp/build/psp_scene_textures_gen.o: $(SCENE_TEX_GEN)

blobs: $(BLOB_REGISTRY)
.PHONY: blobs

# --- Audio assets (Phase 1 bring-up: one soundfont pair + two sequences) -----
#
# Soundfonts/sequences/sample banks use the exact same extern _Start/_Size
# linker-symbol convention already proven for scene data, but unlike scenes
# they are NOT linked directly into the PSP binary. AudioLoad_RelocateFont
# (src/audio/internal/load.c) expects a soundfont's internal cross-references
# (Instrument/Drum/SoundEffect offsets) to arrive as plain integers relative
# to wherever the DMA landed it in RAM, fixing them up into real pointers only
# after the copy -- this is the real, intentional wire format (confirmed by
# reading AudioLoad_RelocateFont itself), not a limitation to work around, and
# it's exactly what "compile, partial-link at a floating base, sfpatch its
# symbols to section-relative ABS values" already produces. So instead of
# linking these objects, their payload section is extracted as a flat binary
# (same objcopy -O binary technique the scene blob debug rule already uses)
# and served through the EXISTING blob mechanism (psp_blob_assets.c/
# PspBlob_Read) via a fake-but-real DMA read -- see psp/src/libultra/os_pi.c's
# osEPiStartDma and psp/src/psp_audio_tables.c, which is what actually points
# at these vromStart values.
#
# Reuses build/pal-1.0/assets/audio/** -- the *intermediate* .c/.h/.name/.s
# files the main N64 Makefile's audio rules already produce via the same
# platform-agnostic host tools (tools/audio/sfc/sbc/sampleconv; these only
# ever process XML descriptors and .wav samples, never touch a MIPS/N64
# toolchain). Not regenerated here to avoid re-deriving that pipeline's
# sample-format wildcard logic (.wav vs .half.wav) a second time. Before a
# clean build, generate them once via the real N64 toolchain:
#   make VERSION=pal-1.0 \
#     build/pal-1.0/assets/audio/soundfonts/Soundfont_0.c \
#     build/pal-1.0/assets/audio/soundfonts/Soundfont_1.c \
#     build/pal-1.0/assets/audio/samplebanks/SampleBank_0.s \
#     build/pal-1.0/assets/audio/sequences/seq_0.prg.o \
#     build/pal-1.0/assets/audio/sequences/seq_72.o
# (the last two just need their .s siblings, produced as a side effect).
# Full asset coverage would want its own self-contained script (mirroring
# make_scene_blob.sh) instead of this reuse -- real follow-up work, out of
# scope for bring-up.
# AUDIO_SRC_DIR / PSP_AUDIO_DIR are defined up with the asset lists, which have
# to come before the rules that use them in a prerequisite list.
# Under psp/build/assets/audio (not just psp/build/audio) so that
# "-I psp/build" (added to INCDIR below) makes session_init.c's
# #include "assets/audio/soundfont_sizes.h" resolve here, same relative-path
# convention the N64 build uses via its own "-I build/pal-1.0".

SFPATCH = tools/audio/sfpatch
PSP_AFILE_SIZES = tools/audio/afile_sizes
# The real linker, not PSPSDK's LD (= psp-gcc): the soundfont link below is a
# bare data link driven entirely by soundfont.ld, with no crt0 and no libc.
AUDIO_LD = psp-ld

# Soundfont: compile -> partial-link (soundfont.ld) -> patch symbols to ABS ->
# objcopy in the real _Start/_Size names. Same 4-step pipeline as the N64
# Makefile's soundfont rule, psp-gcc/psp-ld/psp-objcopy substituted for the
# N64 toolchain (tools/audio/sfpatch itself needed a real fix this session to
# accept little-endian ELF input at all -- it previously hardcoded a
# big-endian-only assumption from never having seen non-N64 input). The
# result is an intermediate used two ways below: afile_sizes reads its real
# section size, and objcopy -O binary extracts its payload as a blob -- it is
# NOT linked into the PSP binary (see the block comment above).
$(PSP_AUDIO_DIR)/Soundfont_%.o: $(AUDIO_SRC_DIR)/soundfonts/Soundfont_%.c $(AUDIO_SRC_DIR)/soundfonts/Soundfont_%.name
	@mkdir -p $(PSP_AUDIO_DIR)
	$(CC) -c $(CFLAGS) -I include/audio -w -o $(@:.o=.tmp.o) $<
	$(LD) -r -T linker_scripts/soundfont.ld $(@:.o=.tmp.o) -o $(@:.o=.tmp2.o)
	$(SFPATCH) $(@:.o=.tmp2.o) $(@:.o=.tmp2.o)
	$(OBJCOPY) --add-symbol $$(cat $(word 2,$^) | tr -d '\0')_Start=.rodata:0,global \
		--redefine-sym __LEN__=$$(cat $(word 2,$^) | tr -d '\0')_Size \
		--add-section .note.name=$(word 2,$^) $(@:.o=.tmp2.o) $@
	@$(RM) $(@:.o=.tmp.o) $(@:.o=.tmp2.o)

# Sample bank: the .s already contains its own real _Start/_Size symbols
# (written directly by tools/audio/sbc) -- straight assemble, no patching.
$(PSP_AUDIO_DIR)/SampleBank_%.o: $(AUDIO_SRC_DIR)/samplebanks/SampleBank_%.s
	@mkdir -p $(PSP_AUDIO_DIR)
	$(AS) -c $< -o $@

# Sequences: the committed hand-written one (seq_0, the SFX-id meta-sequence
# session_init.c's PERMANENT_POOL_SIZE hardcodes needing) and one real
# extracted, audible sequence (seq_72 / NA_BGM_OCA_TIME, the Song of Time
# ocarina fanfare -- short, distinctive, uses only Soundfont_0, good for
# verifying by ear). Both already preprocessed into build/pal-1.0/assets/
# audio/sequences/*.s by the real N64 Makefile rule (SEQ_CPP) -- straight
# assemble here, same as the sample bank above. Unlike soundfonts, a
# sequence's bytecode is read by hand-rolled shift/mask code
# (src/audio/internal/seqplayer.c), not cast to a typed struct, so it needs
# no relocation at all -- served as a blob purely for consistency/packaging,
# not because the format demands it.
$(PSP_AUDIO_DIR)/seq_%.o: $(AUDIO_SRC_DIR)/sequences/seq_%.s
	@mkdir -p $(PSP_AUDIO_DIR)
	$(AS) -c $< -o $@

# The real sequence->soundfont mapping, assembled from the game's own generated
# source (atblgen --sequences) instead of the hand-built stand-in this port
# started with. Unlike every other audio asset this one IS linked in directly:
# AudioLoad_Init assigns it as a plain pointer (gAudioCtx.sequenceFontTable =
# gSequenceFontTable) and never DMAs it.
$(PSP_AUDIO_DIR)/sequence_font_table.o: $(AUDIO_SRC_DIR)/sequence_font_table.s
	@mkdir -p $(PSP_AUDIO_DIR)
	$(AS) -c $< -o $@

# soundfont_sizes.h/sequence_sizes.h: session_init.c (src/audio/game/) hard-
# references Soundfont_0_SIZE/Soundfont_1_SIZE/Sequence_0_SIZE by name for its
# permanent-pool size calculation -- real values read back out of the real
# compiled objects above, not guessed.
$(PSP_AUDIO_DIR)/soundfont_sizes.h: $(AUDIO_FONT_OBJS)
	$(PSP_AFILE_SIZES) $@ NUM_SOUNDFONTS SOUNDFONT_SIZES .rodata $^

$(PSP_AUDIO_DIR)/sequence_sizes.h: $(AUDIO_SEQ_OBJS)
	$(PSP_AFILE_SIZES) $@ NUM_SEQUENCES SEQUENCE_SIZES .data $^

src/audio/game/session_init.o: $(PSP_AUDIO_DIR)/soundfont_sizes.h $(PSP_AUDIO_DIR)/sequence_sizes.h

# A soundfont's .o is NOT a usable payload: it is a PARTIAL link, so its
# .rodata still carries unapplied relocations and every instrument/drum/sfx
# offset and every SampleBank_0_SAMPLE_*_Off reference reads back as zero.
# objcopy'ing it straight to a binary produced a 15008-byte file that was all
# zeroes where the pointer table should be -- which the engine loads without
# complaint, relocates into 92 NULL instruments, and plays as silence.
#
# Resolving them needs a real link: the sample bank object supplies the
# SAMPLE_*_Off symbols (-R = take symbols only, contribute no sections) and
# soundfont.ld places .rodata at 0 so the internal offsets stay file-relative.
# This mirrors the main Makefile's own AUDIO_BUILD_DEBUG rule, which exists
# for exactly this purpose and cross-checks its output against the real
# audiobank bytes ripped from the ROM.
#
# Verified: the linked payload's offset words match oot-pal-1.0.z64's own
# Audiobank at 0xD8C0 exactly (allowing for the intended endian flip -- the
# ROM stores them big-endian, psp-gcc emits them little-endian, and the engine
# reads them natively on each target).
# Every sample bank, not just bank 0: a soundfont references whichever bank its
# own table entry names, and an unresolved SAMPLE_*_Off is exactly the
# silent-zero failure this link exists to prevent.
$(PSP_AUDIO_DIR)/Soundfont_%.elf: $(PSP_AUDIO_DIR)/Soundfont_%.o $(AUDIO_BANK_OBJS)
	$(AUDIO_LD) $(foreach f,$(AUDIO_BANK_OBJS),-R $f) -T linker_scripts/soundfont.ld $< -o $@

# Landed in $(BLOB_DIR) so blobs/.stamp's existing "cp -f $(BLOB_DIR)/*.bin
# blobs/" ships them for free. Sequences carry their payload in .data (a plain
# assembled byte stream), soundfonts and sample banks in .rodata.
$(BLOB_DIR)/Soundfont_%.bin: $(PSP_AUDIO_DIR)/Soundfont_%.elf
	@mkdir -p $(BLOB_DIR)
	$(OBJCOPY) -O binary -j .rodata $< $@

$(BLOB_DIR)/SampleBank_%.bin: $(PSP_AUDIO_DIR)/SampleBank_%.o
	@mkdir -p $(BLOB_DIR)
	$(OBJCOPY) -O binary -j .rodata $< $@

$(BLOB_DIR)/seq_%.bin: $(PSP_AUDIO_DIR)/seq_%.o
	@mkdir -p $(BLOB_DIR)
	$(OBJCOPY) -O binary -j .data $< $@


INCDIR = psp/include psp/include/gfx include src . extracted/pal-1.0 build/pal-1.0 psp/build $(BLOB_DIR)
# PLATFORM_N64=1 matches how the decomp itself builds pal-1.0 (see
# reference/oot's own Makefile) -- keeps ported src/ files on the same #if
# branches a real N64 build takes, rather than drifting onto GC/iQue-only
# paths. OOT_VERSION/DEBUG_FEATURES/NDEBUG mirror that build's own recipe.
# Where a fresh launch lands. z_opening.c guards its default with #ifndef, so
# this overrides it without touching the source -- which matters, because a
# temporarily-edited default is exactly the kind of thing that gets committed
# by accident while debugging one scene. SELECT still reaches every scene at
# runtime; this only saves the warp on each rebuild.
#   make -f Makefile.psp BOOT=ENTR_BOTTOM_OF_THE_WELL_0
BOOT ?=
ifneq ($(BOOT),)
BOOT_FLAG = -DPSP_BOOT_ENTRANCE=$(BOOT)
endif

# Hardware bring-up ladder: stop after stage n, idle, and exit to the XMB
# instead of starting the game. See the long note above main() in
# psp/src/main.c. Only psp/src/main.c reads this, so switching levels does not
# need a full rebuild -- but the Makefile does NOT track CFLAGS changes at all,
# so `touch psp/src/main.c` is required when changing it (the same trap that
# produced a half-audio-disabled binary while chasing this bug).
#   make -f Makefile.psp BRINGUP=0
BRINGUP ?=
ifneq ($(BRINGUP),)
BOOT_FLAG += -DPSP_BRINGUP_LEVEL=$(BRINGUP)
endif

# Diagnostic: how many frames the IN-FRAME probes stay active for, counted from
# the start of each gamestate (graph.c resets the counter after
# gamestate-init-done, so this is "the first n frames of each scene", not "of
# the boot"). Default 3. Widen it when a scene dies a few frames in -- the
# Hyrule Field run died in frame 7 of a freshly loaded scene, i.e. four frames
# past the standard window.
#   make -f Makefile.psp DIAGFRAMES=16
DIAGFRAMES ?=
ifneq ($(DIAGFRAMES),)
BOOT_FLAG += -DPSP_DIAG_FRAMES=$(DIAGFRAMES)
endif

# Diagnostic: DIAGSYNC=0 stops the boot trace from force-flushing inside the
# window under investigation, leaving only the periodic batch flush. See the
# note on PspDiag_StepSync in psp/src/psp_hw_diag.c -- the Memory Stick write
# burst is itself a suspect.
DIAGSYNC ?=
ifneq ($(DIAGSYNC),)
BOOT_FLAG += -DPSP_DIAG_SYNC=$(DIAGSYNC)
endif

# Master switch for ALL diagnostics: DIAG=0 compiles the boot trace, the
# bring-up ladder and every probe out of the build entirely -- no log file is
# even opened. See psp/include/psp_hw_diag.h. Default is on.
DIAG ?=
ifneq ($(DIAG),)
BOOT_FLAG += -DPSP_DIAG_ENABLED=$(DIAG)
endif

# Diagnostic: build with PSP_DISABLE_AUDIO=1 to leave AudioMgr and the PSP
# audio backend unstarted. Used to tell a fault on the audio thread apart from
# one on the graphics thread, which a boot trace alone cannot do.
PSP_DISABLE_AUDIO ?= 0

# -fno-strict-aliasing / -fwrapv: the decomp type-puns constantly (Gfx/Mtx/
# unions, s16 pairs read as s32) and relies on wrapping signed arithmetic. Both
# are things -O2 is otherwise free to "optimise" into different code, and the
# resulting divergence only shows up as a wrong value at runtime -- exactly the
# class of bug that reads as a hardware-only fault. reference/oot-psp-z2442
# carries both flags for the same reason.
CFLAGS = -DPSP_DISABLE_AUDIO=$(PSP_DISABLE_AUDIO) -O2 -G0 -Wall -fno-strict-aliasing -fwrapv -D_PSP_FW_VERSION=600 -DPLATFORM_N64=1 -DPLATFORM_GC=0 -DPLATFORM_IQUE=0 \
         -DOOT_VERSION=PAL_1_0 -DDEBUG_FEATURES=0 -DNDEBUG -DTARGET_PSP=1 -DNON_MATCHING=1 -DAVOID_UB=1 \
         -DF3DEX_GBI_2 -DMML_VERSION=MML_VERSION_OOT $(BOOT_FLAG) -include libc/assert.h
CXXFLAGS = $(CFLAGS) -fno-exceptions -fno-rtti
ASFLAGS = $(CFLAGS)

# PSPSDK's build.mak defines CC/AS/LD (all psp-gcc) but not OBJCOPY -- the
# audio-assets block above needs it directly (partial-linked soundfont
# symbol patching, and extracting blob payloads via -O binary).
OBJCOPY = psp-objcopy

LIBDIR = psp/lib
# -lme-core boots the Media Engine (psp/src/audio/psp_audio_me.c). It embeds
# the kcall.prx kernel bridge it needs, so nothing extra ships on the stick.
LIBS = -lme-core -lpspfpu -lpspgum -lpspgu -lpspdisplay -lpspctrl -lpspge -lpspmath -lpsppower -lpspaudio -lm

# D_01000000 is not data -- it is a segmented ADDRESS that the N64 build's own
# spec resolves to the literal 0x01000000, and segment 1 is the billboard matrix
# (z_play.c: gSPSegment(POLY_OPA_DISP++, 0x01, this->billboardMtx)). Code writes
# `gSPMatrix(..., &D_01000000, ...)`, i.e. it emits 0x01000000 into the display
# list, and gfx_pc.c's seg_addr() resolves it against gSegments[1] at draw time.
# So the faithful port is to reproduce the absolute symbol, not to allocate a
# real Mtx here -- allocating one would silently give every billboarded sprite
# an identity matrix instead of the camera's.
LDFLAGS += -Wl,--defsym,D_01000000=0x01000000
# Same thing one segment along. D_06000000 is the base of the OBJECT segment,
# written into a display list by actors that want "the object I am holding,
# from its start" (Bg_Jya_Bombiwa and friends). Like D_01000000 it is an
# address the N64 spec resolves literally, not a variable, so allocating
# storage for it would hand the GE a pointer to four zero bytes instead.
LDFLAGS += -Wl,--defsym,D_06000000=0x06000000

BUILD_PRX = 1
PSP_EBOOT_TITLE = OoT PSP (bring-up)
EXTRA_TARGETS = EBOOT.PBP blobs/.stamp

PSPSDK = $(shell psp-config --pspsdk-path)
include $(PSPSDK)/lib/build.mak
